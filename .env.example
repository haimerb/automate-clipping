# Plantilla de configuración de edgetape. Copia a `.env` y completa tus valores.
# ⚠️ NUNCA quemes credenciales en el código: todo se lee de aquí o del entorno.

# Postgres — requisito para usuarios/login/cuentas vinculadas.
EDGETAPE_DATABASE_URL=postgresql+psycopg2://USUARIO:CONTRASENA@HOST:5432/BD

# Secreto para firmar JWT. Genera uno: python -c "import secrets; print(secrets.token_urlsafe(48))"
EDGETAPE_JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# Cola durable de jobs: Celery + Redis (docker compose up -d lo levanta).
# "celery" envía las tareas a Redis; cualquier otro valor las corre en local (tests).
EDGETAPE_CELERY_BROKER=redis://localhost:6379/0
EDGETAPE_ASYNC_BACKEND=celery

# Publicación a YouTube:
# tope de subidas por canal por día y delay mínimo entre subidas (segundos).
# El límite del canal es una restricción de YouTube (~10-20/día en canales
# nuevos); un tope de 5/día evita por completo el uploadLimitExceeded que
# pausa la cuenta 24h sin frenar publicaciones normales.
# EDGETAPE_MAX_UPLOADS_PER_DAY=5
# EDGETAPE_MIN_UPLOAD_DELAY=600

# Modo de export vertical de los clips: vertical_blur | vertical_crop | original
# EDGETAPE_EXPORT_MODE=vertical_blur

# Pausas deliberadas del pipeline (en segundos). Reducirlas acelera
# el procesado; en producción con Groq conviene mantener el default para
# no quemar el rate limit de 30 RPM.
# EDGETAPE_METADATA_DELAY=5
# EDGETAPE_QUEUE_TASK_DELAY=10
# Edge: EDGETAPE_OLLAMA_PROBE=0 desactiva el probe de Ollama local.

# Credenciales de YouTube OAuth (fallback si la cuenta vinculada no tiene las suyas)
# EDGETAPE_YT_CLIENT_ID=
# EDGETAPE_YT_CLIENT_SECRET=
# En producción apunta al deploy (HF Spaces: https://TU-USUARIO-APP.hf.space)
# EDGETAPE_YT_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# Dominio PÚBLICO del deploy. Necesario para Instagram: Meta tiene que poder
# descargar el video desde una URL. Edgetape sirve un link firmado por clip
# (/api/public/clips/...); sin esto el Reel queda como publicación manual.
# EDGETAPE_PUBLIC_BASE_URL=http://localhost:8000

# TikTok (Content Posting API) — credenciales de la app en TikTok for Developers.
# También se pueden guardar por cuenta en CUENTAS (tienen prioridad).
# Sin app auditada TikTok solo acepta SELF_ONLY (el video queda privado).
# EDGETAPE_TIKTOK_CLIENT_KEY=
# EDGETAPE_TIKTOK_CLIENT_SECRET=
# EDGETAPE_TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/callback
# EDGETAPE_TIKTOK_PRIVACY=SELF_ONLY   # PUBLIC_TO_EVERYONE con la app aprobada

# Meta / Facebook Login (Facebook + Instagram Reels). Permisos que pide el
# diálogo: pages_show_list, pages_manage_posts, instagram_basic,
# instagram_content_publish. Al conectar se detectan páginas e IG business.
# EDGETAPE_META_CLIENT_ID=
# EDGETAPE_META_CLIENT_SECRET=
# EDGETAPE_META_REDIRECT_URI=http://localhost:8000/api/meta/callback

# yt-dlp: cookies Netscape para videos restringidos
# EDGETAPE_YT_COOKIES=

# Groq API — gratis, sin tarjeta de crédito. Velocidad: 400-600 tok/s.
# Obtener clave en: https://console.groq.com (signup sin tarjeta)
# EDGETAPE_GROQ_API_KEY=gsk_xxxxx
# EDGETAPE_GROQ_MODEL=gemma2-9b-it                # metadata viral
# EDGETAPE_GROQ_WHISPER_MODEL=whisper-large-v3-turbo  # transcripción

# Subtítulos quemados estilo viral en los clips exportados (gancho en MAYÚSCULAS,
# borde #1E3A8A, sombra #FFC647). 1 = activado.
# EDGETAPE_BURN_SUBTITLES=1

# ── Video generado con IA: material de stock (b-roll real) ───────────────
# Clips de video reales con movimiento para las escenas del video generado.
# Ambas APIs son gratis; con una sola basta. Sin claves el motor usa
# imágenes de Wikimedia y, si no hay nada, fondos de marca variados.
# Pexels: https://www.pexels.com/api/   Pixabay: https://pixabay.com/api/docs/
# EDGETAPE_PEXELS_API_KEY=
# EDGETAPE_PIXABAY_API_KEY=
# EDGETAPE_STOCK_MATERIALS=0        # desactiva todo el material de stock

# Música de fondo opcional (se elige por job). La carpeta debe tener pistas
# royalty-free en mp3/m4a/wav. El job puede pedir "none" o una pista concreta.
# EDGETAPE_MUSIC_DIR=backend/assets/music
# EDGETAPE_MUSIC_VOLUME=0.22

# Proveedor opcional de video generativo. Solo se usa cuando el catálogo de
# stock no trae material para una escena (es de pago, así que va acotado).
#   EDGETAPE_VIDEOGEN_MODE=image   -> POST {BASE}/images/generations (OpenAI-compatible)
#   EDGETAPE_VIDEOGEN_MODE=webhook -> POST a BASE esperando {"video_url": "..."}
# En modo webhook la URL debe incluir el endpoint (p. ej. .../v1/video/generate).
# EDGETAPE_VIDEOGEN_BASE_URL=
# EDGETAPE_VIDEOGEN_API_KEY=
# EDGETAPE_VIDEOGEN_MODEL=
# EDGETAPE_VIDEOGEN_MODE=image
# EDGETAPE_VIDEOGEN_MAX_SCENES=1  # tope de escenas por job (protege la cuota)
# EDGETAPE_VIDEOGEN=0             # desactiva el proveedor aunque esté configurado


# Colab integration (opcional) — para transcripción con GPU. El notebook
# consulta GET /api/jobs/{job_id}/task (público con el COLAB_SECRET) en lugar
# de /api/jobs/{job_id} (que exige JWT), y run_job reutiliza transcription.json
# si existe (transcriber = "colab-whisper").
# EDGETAPE_COLAB_SECRET=secreto-compartido
